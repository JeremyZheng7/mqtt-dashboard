// cypress/integration/app.spec.js
describe('应用基础功能测试', () => {
  // 测试登录功能
  it('应该成功登录', () => {
    cy.visit('/login')
    cy.get('#username').type('testuser')
    cy.get('#password').type('testpassword')
    cy.get('#login-btn').click()
    cy.url().should('include', '/dashboard')
  })

  // 测试MQTT连接状态
  it('应该显示正确的MQTT连接状态', () => {
    cy.get('.mqtt-status').should('have.text', '已连接')
  })

  // 测试图表数据更新
  it('应该每秒更新温度数据', (done) => {
    let initialTemp
    cy.get('#temperature-chart')
      .should(($chart) => {
        initialTemp = parseFloat($chart.find('.data-point').first().text())
      })
      .wait(1100)
      .then(() => {
        cy.get('#temperature-chart')
          .find('.data-point')
          .first()
          .should(($el) => {
            const newTemp = parseFloat($el.text())
            expect(newTemp).to.not.equal(initialTemp)
          })
      })
    done()
  })
})
